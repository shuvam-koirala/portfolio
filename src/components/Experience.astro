---
import { experience, education } from '../data/site';
---
<section id="experience">
  <div class="wrap">
    <span class="label">Experience</span>
    <h2 class="reveal">Where I've worked.</h2>
    <ol class="timeline">
      {experience.map((e) => (
        <li class="reveal">
          <p class="period">{e.period}</p>
          <div>
            <h3>{e.role}</h3>
            <p class="company">{e.company}</p>
            <p class="muted">{e.summary}</p>
          </div>
        </li>
      ))}
      <li class="reveal">
        <p class="period">{education.year}</p>
        <div>
          <h3>{education.degree}</h3>
          <p class="company">{education.school}</p>
        </div>
      </li>
    </ol>
  </div>
</section>

<style>
  .timeline {
    list-style: none;
    margin: 2.5rem 0 0;
    padding: 0;
  }
  .timeline li {
    display: grid;
    grid-template-columns: 11rem 1fr;
    gap: 1.5rem;
    padding: 1.6rem 0;
    border-top: 1px solid var(--border);
  }
  .period {
    font-size: 0.92rem;
    color: var(--muted);
    margin: 0.2rem 0 0;
  }
  h3 {
    margin-bottom: 0.2rem;
  }
  .company {
    font-weight: 600;
    color: var(--label);
    margin-bottom: 0.6rem;
  }
  .timeline .muted {
    margin: 0;
    max-width: 44rem;
  }
  @media (max-width: 640px) {
    .timeline li {
      grid-template-columns: 1fr;
      gap: 0.4rem;
    }
  }
</style>
