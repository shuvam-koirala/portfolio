---
import { site } from '../data/site';
---
<section id="contact" class="contact">
  <div class="wrap">
    <div class="panel reveal">
      <span class="label">Contact</span>
      <h2>Have an app in mind?</h2>
      <p class="muted lede">{site.replyPromise}</p>
      <div class="actions">
        <a class="btn-primary" href={`mailto:${site.email}?subject=${encodeURIComponent('New app project')}`}>
          {site.cta} <span aria-hidden="true">→</span>
        </a>
        <a class="email" href={`mailto:${site.email}`}>{site.email}</a>
      </div>
      <p class="social">
        <a class="link-quiet" href={site.linkedin} rel="me">LinkedIn</a>
        <a class="link-quiet" href={site.github} rel="me">GitHub</a>
      </p>
    </div>
  </div>
</section>

<style>
  .panel {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: calc(var(--radius) * 1.5);
    padding: clamp(2rem, 6vw, 4rem);
    text-align: center;
    box-shadow: var(--shadow);
  }
  h2 {
    font-size: clamp(2rem, 4.5vw, 3rem);
  }
  .lede {
    font-size: 1.15rem;
  }
  .actions {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    margin: 2rem 0 1.5rem;
  }
  .email {
    font-weight: 500;
    word-break: break-all;
  }
  .social {
    display: flex;
    justify-content: center;
    gap: 1.5rem;
    margin: 0;
  }
</style>
